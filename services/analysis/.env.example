# 예시 파일은 자동으로 로드되지 않습니다. 환경 변수로 설정하세요.
WEAVO_ENV=local
WEAVO_SITE_REDIS_URL=redis://127.0.0.1:16379
WEAVO_SITE_DB_URL=jdbc:postgresql://127.0.0.1:15432/weavo
WEAVO_SITE_DB_USER=weavo
# 로컬 PostgreSQL의 설정값과 동일하게 지정합니다.
# WEAVO_SITE_DB_PASSWORD=
WEAVO_AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-northeast-2
# dev/prod에서는 아래를 명시하고 endpoint를 비워야 합니다.
# WEAVO_S3_BUCKET=
# WEAVO_ANALYSIS_QUEUE=
# WEAVO_RESULT_QUEUE=

# worker-test 프로필 실행 시 내부 Control 주소와 서비스 전용 Bearer 값을 설정합니다.
# WEAVO_CONTROL_URL=http://localhost:8082
# WEAVO_SERVICE_TOKEN=
