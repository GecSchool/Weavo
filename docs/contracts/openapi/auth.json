{
  "openapi": "3.1.0",
  "info": {
    "title": "Weavo Auth HTTP 계약 초안",
    "version": "0.1.0",
    "description": "팀 내부 개발 계약이다. API의 형식은 이 문서를, 서비스 간 처리와 구현 검증은 계약 README를 따른다."
  },
  "paths": {
    "/auth/v1/email-verifications": {
      "post": {
        "summary": "POST /auth/v1/email-verifications",
        "description": "처리: 202 회원가입용 6자리 인증번호 발송\n가입 번호의 202는 메일 공급자 접수 확인.\n가입용 번호는 6자리·5분·최대 5회다. 202는 메일 공급자의 접수 확인이다. 재발송 시 기존 번호와 증명을 무효화한다.",
        "responses": {
          "202": {
            "description": "요청 접수; 후속 작업은 별도 확인.; 응답 본문 없음"
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/email-verifications/confirm": {
      "post": {
        "summary": "POST /auth/v1/email-verifications/confirm",
        "description": "처리: 200 가입 전용 일회용 verification_token\n이메일과 6자리 가입 번호를 확인한다. verification_token은 가입 목적·이메일에 결합된 10분 유효 일회용 증명이다.",
        "responses": {
          "200": {
            "description": "성공.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verification_token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "verification_token"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "description": "6자리 숫자 인증번호. 앞자리 0을 보존한다."
                  }
                },
                "required": [
                  "email",
                  "code"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/signup": {
      "post": {
        "summary": "POST /auth/v1/signup",
        "description": "처리: 목적·이메일·유효 기간·미사용 증명 확인 후 201 user_id\n가입 증명의 목적·이메일·유효 기간·미사용 여부를 확인하고 소비한다. 처리 실패 또는 결과 불확실 시 재인증한다.\n신규 비밀번호는 최소 10자와 영문·숫자·특수문자를 각 하나 이상 포함한다. 비밀번호 형식 검사는 인증 증명 소비 전에 수행한다. 입력 오류를 고쳐 같은 유효 증명으로 재제출할 수 있다.",
        "responses": {
          "201": {
            "description": "생성 성공.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "user_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "신규 비밀번호 조건 불충족; 아직 증명을 소비하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "INVALID_PASSWORD"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 10,
                    "allOf": [
                      {
                        "pattern": "[A-Za-z]"
                      },
                      {
                        "pattern": "[0-9]"
                      },
                      {
                        "pattern": "[!-/:-@\\[-`{-~]"
                      }
                    ],
                    "description": "최소 10자. 영문자·숫자·ASCII 특수문자를 각각 하나 이상 포함한다. 12자 최대 제한 없음. 신규 비밀번호에만 적용."
                  },
                  "verification_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "verification_token"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/login": {
      "post": {
        "summary": "POST /auth/v1/login",
        "description": "처리: 200 access_token·csrf_token·refresh 쿠키\naccess_token·csrf_token과 HttpOnly Secure weavo_refresh 쿠키를 발급한다.",
        "responses": {
          "200": {
            "description": "성공.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "csrf_token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "access_token",
                    "csrf_token"
                  ]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "weavo_refresh; HttpOnly; Secure; 교차 사이트에서 SameSite=None"
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/refresh": {
      "post": {
        "summary": "POST /auth/v1/refresh",
        "description": "처리: 200 새 access_token·csrf_token·refresh 쿠키\nweavo_refresh 쿠키 필요; refresh/logout은 X-CSRF-Token도 필수.\nrefresh 쿠키와 X-CSRF-Token을 확인하고 access·CSRF 토큰 및 refresh 쿠키를 갱신한다.",
        "responses": {
          "200": {
            "description": "성공.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "csrf_token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "access_token",
                    "csrf_token"
                  ]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "weavo_refresh; HttpOnly; Secure; 교차 사이트에서 SameSite=None"
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "RefreshCookie": []
          }
        ]
      }
    },
    "/auth/v1/logout": {
      "post": {
        "summary": "POST /auth/v1/logout",
        "description": "처리: 204 세션 폐기\nweavo_refresh 쿠키 필요; refresh/logout은 X-CSRF-Token도 필수.\nrefresh 세션을 폐기한다. 이미 발급된 access token은 만료까지 유효하다.\n정상 요청을 재전달해 이미 폐기된 같은 세션이어도 204를 반환한다.",
        "responses": {
          "204": {
            "description": "성공; 응답 본문 없음."
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "RefreshCookie": []
          }
        ]
      }
    },
    "/auth/v1/me": {
      "get": {
        "summary": "GET /auth/v1/me",
        "description": "처리: 200 현재 사용자; 미인증 401\nBearer access JWT의 서명·만료 및 계정 접근 상태를 검증한다. 인증되지 않으면 401이다.",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user_id",
                    "email",
                    "name"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "인증 실패.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "patch": {
        "summary": "PATCH /auth/v1/me",
        "description": "처리: 200 이름 변경\n현재 사용자 이름을 변경한다.\ntrim 후 1~50자가 아니면 422 INVALID_NAME.",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user_id",
                    "email",
                    "name"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "trim 후 이름이 1~50자가 아닌 경우 INVALID_NAME.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "INVALID_NAME"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "앞뒤 공백을 제거한 값이 1~50자여야 한다. DB display_name에 대응한다."
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "summary": "DELETE /auth/v1/me",
        "description": "처리: 계정 및 소유 데이터 삭제\nControl의 탈퇴 접수 확인 후 웹에 202와 status·job_id를 반환한다.\nControl이 소유 데이터 정리 작업을 접수한 뒤 202를 반환하고 비동기로 탈퇴를 진행한다.\n최종 삭제 확인은 UI에서 진행한다. 별도 확인값·비밀번호·재인증 요청 본문은 없다.",
        "responses": {
          "202": {
            "description": "요청 접수; 후속 작업은 별도 확인.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ACCEPTED"
                    },
                    "job_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  },
                  "required": [
                    "status",
                    "job_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/auth/v1/password-reset-requests": {
      "post": {
        "summary": "POST /auth/v1/password-reset-requests",
        "description": "처리: 202 초기화 요청 접수; 실제 번호 발송을 보장하지 않음\n계정 유무/개별 발송 결과와 무관하게 동일 202, 전체 공통 장애 503 가능.\n가입 여부나 개별 발송 결과를 드러내지 않는 202를 반환한다. 202는 실제 발송을 보장하지 않는다. 공통 시스템 장애는 503이 가능하다.",
        "responses": {
          "202": {
            "description": "요청 접수; 후속 작업은 별도 확인.; 응답 본문 없음"
          },
          "503": {
            "description": "의존 서비스·저장소 장애.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/password-reset-requests/confirm": {
      "post": {
        "summary": "POST /auth/v1/password-reset-requests/confirm",
        "description": "처리: 200 초기화 전용 일회용 reset_token\n이메일과 초기화용 6자리 번호를 확인한다. reset_token은 초기화 목적·이메일에 묶인 10분 유효 일회용 증명이다.",
        "responses": {
          "200": {
            "description": "성공.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reset_token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reset_token"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "description": "6자리 숫자 인증번호. 앞자리 0을 보존한다."
                  }
                },
                "required": [
                  "email",
                  "code"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/password-resets": {
      "post": {
        "summary": "POST /auth/v1/password-resets",
        "description": "처리: 인증 증명 검증·소비 후 비밀번호 변경 및 모든 refresh 세션 폐기; 기존 access token은 만료까지 유효\n증명을 소비해 비밀번호를 변경하고 모든 refresh 세션을 폐기한다. 기존 access token은 만료까지 유효하다.\n신규 비밀번호는 최소 10자와 영문·숫자·특수문자를 각 하나 이상 포함한다. 비밀번호 형식 검사는 인증 증명 소비 전에 수행한다. 입력 오류를 고쳐 같은 유효 증명으로 재제출할 수 있다.",
        "responses": {
          "204": {
            "description": "비밀번호 변경과 refresh 세션 폐기 완료"
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "신규 비밀번호 조건 불충족; 아직 증명을 소비하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "INVALID_PASSWORD"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "JSON 요청 필드와 필수 여부는 아래 스키마를 따른다. 조건별 규칙은 설명과 기존 스펙을 함께 확인한다.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "reset_token": {
                    "type": "string"
                  },
                  "new_password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 10,
                    "allOf": [
                      {
                        "pattern": "[A-Za-z]"
                      },
                      {
                        "pattern": "[0-9]"
                      },
                      {
                        "pattern": "[!-/:-@\\[-`{-~]"
                      }
                    ],
                    "description": "최소 10자. 영문자·숫자·ASCII 특수문자를 각각 하나 이상 포함한다. 12자 최대 제한 없음. 신규 비밀번호에만 적용."
                  }
                },
                "required": [
                  "email",
                  "reset_token",
                  "new_password"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/v1/csrf": {
