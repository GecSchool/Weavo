  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ProjectApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "RefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "weavo_refresh",
        "description": "팀 내부 전송 형식 보완: HttpOnly Secure refresh 세션 쿠키"
      },
      "InternalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "팀 내부 전송 형식 보완: 서비스별 내부 전용 토큰; 사용자의 JWT와 별도"
      }
    }
  }
