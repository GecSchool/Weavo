    "/api/projects/{p}/v{v}/records": {
      "get": {
        "summary": "GET /api/projects/{p}/v{v}/records",
        "description": "처리: 200 data·meta; 필터·정렬·커서 지원\n기본 limit=100, 범위 1~500; cursor, sort_by, sort_order, fields, filter[field][operator]; 여러 필터 AND; cursor 조건/데이터 변경 409.\n동적 필터: filter[field][operator]=value; string eq/contains, number/date/datetime eq/gt/gte/lt/lte, boolean/url eq, 모든 타입 is_null=true|false. 여러 조건 AND, contains 영문 대소문자 무시. 필드명은 프로젝트별 동적이며 OR 미지원.\nfilter[field][operator] 조건은 AND이며 정렬은 단일 필드다. 기본 정렬은 record_id asc이고 동률 시 record_id를 같은 방향으로 사용한다. sort는 NULLS LAST다. 커서 조건·데이터 또는 해당 출처 매핑 revision이 변경되면 409다.",
        "responses": {
          "200": {
            "description": "성공. record_id는 서비스의 전역 저장 식별자, source_id는 공유 출처 식별자다. 사용자 필드는 해당 프로젝트의 활성 스키마에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "프로젝트별 사용자 필드와 시스템 필드; 활성 schema_version에 따라 변함",
                        "properties": {
                          "record_id": {
                            "type": "integer",
                            "description": "Data DB 전역 순차 식별자"
                          },
                          "source_id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "공유 출처 식별자"
                          },
                          "source_url": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "해당 레코드에 직접 접근 가능한 확인된 절대 URL 또는 null"
                          }
                        },
                        "additionalProperties": true,
                        "required": [
                          "record_id",
                          "source_id"
                        ]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "schema_version": {
                          "type": "integer"
                        },
                        "dataset_revision": {
                          "type": "integer"
                        },
                        "returned_count": {
                          "type": "integer"
                        },
                        "next_cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "has_more": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "schema_version",
                        "dataset_revision",
                        "returned_count",
                        "next_cursor",
                        "has_more"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "입력 오류.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "인증 실패.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
