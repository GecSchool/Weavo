    "/api/projects/{p}/v{v}/records/{r}": {
      "get": {
        "summary": "GET /api/projects/{p}/v{v}/records/{r}",
        "description": "처리: 200 data; 없음 404·종료 버전 410\nfields를 사용해도 필수 시스템 식별자는 포함한다. 없는 레코드는 404, 종료된 이전 버전은 410이며 이전 버전에 410을 우선 적용한다.",
        "responses": {
          "200": {
            "description": "성공. record_id는 서비스의 전역 저장 식별자, source_id는 공유 출처 식별자다. 사용자 필드는 해당 프로젝트의 활성 스키마에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "프로젝트별 동적 필드",
                      "properties": {
                        "record_id": {
                          "type": "integer",
                          "description": "Data DB 전역 순차 식별자"
                        },
                        "source_id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "공유 출처 식별자"
                        },
                        "source_url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "해당 레코드에 직접 접근 가능한 확인된 절대 URL 또는 null"
                        }
                      },
                      "additionalProperties": true,
                      "required": [
                        "record_id",
                        "source_id"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "대상 없음.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "410": {
            "description": "종료된 이전 스키마 버전. 최신 버전·경로를 반환하며 구체적 오류 details 키는 정해지지 않았다.",
            "content": {
