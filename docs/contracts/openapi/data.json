{
  "openapi": "3.1.0",
  "info": {
    "title": "Weavo Data HTTP 계약 초안",
    "version": "0.1.0",
    "description": "팀 내부 개발 계약이다. API의 형식은 이 문서를, 서비스 간 처리와 구현 검증은 계약 README를 따른다."
  },
  "paths": {
    "/api/projects/{p}/keys": {
      "get": {
        "summary": "GET /api/projects/{p}/keys",
        "description": "처리: API 키 목록·nullable last_used_at; 비밀값 제외\n키 비밀값을 반환하지 않는다. last_used_at은 RFC3339 UTC이며 사용 이력 없음 또는 Redis 장애 시 null이다.",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "last_used_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "key_id",
                          "name",
                          "last_used_at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "keys"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "details",
                        "retryable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "p",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "description": "식별자 형식은 스키마를 따른다."
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "POST /api/projects/{p}/keys",
        "description": "처리: 201 key_id·최초 1회 secret; 발급 개수 제한 없음\n프로젝트 읽기 전용 키를 발급한다. secret은 발급 응답에서만 제공하고 발급 개수 제한은 두지 않는다.",
        "responses": {
