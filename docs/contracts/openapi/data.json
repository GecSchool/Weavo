              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "description": "식별자 형식은 스키마를 따른다."
          },
          {
            "name": "k",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
