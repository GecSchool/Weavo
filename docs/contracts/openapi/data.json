                  ]
                }
              }
            }
          },
          "default": {
            "description": "명시되지 않은 실패 응답. 상세 code와 retryable은 발생 조건에 따른다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
