{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weavo 공통 데이터 구조 (초안)",
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv4 소문자; 메시지 명세 1.1"
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[Zz]|\\+00:00)$",
      "description": "RFC3339 UTC; 메시지 명세 1.2"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
      "description": "절대 HTTP(S) URL; 실행 시 URL 안전성 검사 필요"
    },
    "s3Ref": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "bucket",
        "key"
      ],
      "description": "허용 버킷·prefix와 소유 범위 확인은 실행 단계에서 수행. 명세 1.3"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        },
        "failure_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "project_source_id": {
                "$ref": "#/definitions/uuid"
              },
              "field_id": {
                "$ref": "#/definitions/uuid"
              },
              "ref": {
                "$ref": "#/definitions/s3Ref"
              },
              "expires_at": {
                "$ref": "#/definitions/timestamp"
              }
            },
            "required": [
              "project_source_id",
              "field_id",
              "ref",
              "expires_at"
            ]
          }
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "description": "1.4: failure_evidence 없으면 생략 또는 빈 배열"
    },
    "commandEnvelope": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "command_type": {
          "type": "string"
        },
        "job_id": {
          "$ref": "#/definitions/uuid"
        },
        "parent_job_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_at": {
          "$ref": "#/definitions/timestamp"
        },
        "expires_at": {
          "$ref": "#/definitions/timestamp"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "format_version",
        "command_type",
        "job_id",
        "parent_job_id",
        "requested_at",
        "expires_at",
        "payload"
      ],
      "description": "요청 envelope; 명세 3.1"
    },
    "eventEnvelope": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "event_type": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/definitions/uuid"
        },
        "job_id": {
          "$ref": "#/definitions/uuid"
        },
        "occurred_at": {
          "$ref": "#/definitions/timestamp"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "format_version",
        "event_type",
        "event_id",
        "job_id",
        "occurred_at",
        "payload"
      ],
      "description": "결과 envelope; 명세 3.2"
    },
    "schemaField": {
      "type": "object",
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "api_name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "datetime",
            "url"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_order": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommendation_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field_id",
        "api_name",
        "display_name",
        "type",
        "nullable"
      ],
      "description": "필드 예제 5.1; 승인 schema.prepare의 추가 필수값은 해당 메시지에서 적용"
    },
    "schema": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/schemaField"
          }
        }
      },
      "required": [
        "fields"
      ]
    },
    "userFieldValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "날짜·일시·URL은 문자열. 명세 1.2"
    },
    "latestRecord": {
      "type": "object",
      "properties": {
        "field_values": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/uuid"
          },
          "additionalProperties": {
            "$ref": "#/definitions/userFieldValue"
          },
          "description": "현재 스키마의 사용자 필드 전체. 필드 집합과 타입 대조는 서비스 검증 필요"
        }
      },
      "required": [
        "field_values"
      ]
    },
    "latestRecords": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/latestRecord"
      },
      "maxItems": 3
    },
    "initialAction": {
      "type": "object",
      "properties": {
        "type": {
          "const": "CLICK"
        },
        "selector": {
          "type": "string"
        },
        "wait_selector": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "selector",
        "wait_selector"
      ],
      "description": "순서가 있는 초기 동작; 명세 5.2"
    },
    "listAccess": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "HTTP",
            "BROWSER"
          ]
        },
        "wait_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "method"
      ],
      "description": "wait_selector 누락 허용 여부는 확인 필요"
    },
    "pagination": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "NONE",
            "NEXT_LINK",
            "URL_TEMPLATE",
            "CLICK_NEXT",
            "LOAD_MORE",
            "SCROLL"
          ]
        },
        "selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url_attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url_template": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "scroll_container_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "NEXT_LINK"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selector",
              "url_attribute"
            ],
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "url_attribute": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "URL_TEMPLATE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url_template",
              "start",
              "step"
            ],
            "properties": {
              "url_template": {
                "type": "string",
                "pattern": "^(?=[Hh][Tt][Tt][Pp][Ss]?://)(?!.*\\{value\\}.*\\{value\\}).*\\{value\\}.*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "CLICK_NEXT"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selector",
              "wait_selector"
            ],
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "wait_selector": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "LOAD_MORE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selector",
              "wait_selector"
            ],
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "wait_selector": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SCROLL"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "wait_selector"
            ],
            "properties": {
              "wait_selector": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "description": "종류별 필수 항목은 명세 5.2. SCROLL container null은 문서 스크롤"
    },
    "navigation": {
      "type": "object",
      "properties": {
        "list_url": {
          "$ref": "#/definitions/httpUrl"
        },
        "initial_actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/initialAction"
          }
        },
        "list_access": {
          "$ref": "#/definitions/listAccess"
        },
        "item_selector": {
          "type": "string"
        },
        "pagination": {
          "$ref": "#/definitions/pagination"
        }
      },
      "required": [
        "list_url",
        "initial_actions",
        "list_access",
        "item_selector",
        "pagination"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "list_access": {
                "properties": {
                  "method": {
                    "const": "HTTP"
                  }
                },
                "required": [
                  "method"
                ]
              }
            },
            "required": [
              "list_access"
            ]
          },
          "then": {
            "properties": {
              "initial_actions": {
                "maxItems": 0
              },
              "pagination": {
                "properties": {
                  "type": {
                    "enum": [
                      "NONE",
                      "NEXT_LINK",
                      "URL_TEMPLATE"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "description": "명세 5.2·20.2; 공유 동일성·진행 확인은 실행 로직"
    },
    "detailAccess": {
      "type": "object",
      "properties": {
        "method": {
          "const": "BROWSER"
        },
        "wait_selector": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "wait_selector"
      ]
    },
    "detailOpen": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "LINK",
            "CLICK"
          ]
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "CURRENT_TAB",
            "NEW_TAB",
            "MODAL"
          ]
        },
        "url_attribute": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "selector",
        "target"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "LINK"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url_attribute"
            ],
            "properties": {
              "url_attribute": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "detailReturn": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HISTORY_BACK",
            "CLOSE_TAB",
            "CLOSE"
          ]
        },
        "wait_selector": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "wait_selector"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "CLOSE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selector"
            ],
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "detailNavigation": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/definitions/detailAccess"
        },
        "open": {
          "$ref": "#/definitions/detailOpen"
        },
        "return": {
          "$ref": "#/definitions/detailReturn"
        }
      },
      "required": [
        "access",
        "open",
        "return"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "open": {
                "properties": {
                  "target": {
                    "const": "CURRENT_TAB"
                  }
                },
                "required": [
                  "target"
                ]
              }
            },
            "required": [
              "open"
            ]
          },
          "then": {
            "properties": {
              "return": {
                "properties": {
                  "type": {
                    "const": "HISTORY_BACK"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "open": {
                "properties": {
                  "target": {
                    "const": "NEW_TAB"
                  }
                },
                "required": [
                  "target"
                ]
              }
            },
            "required": [
              "open"
            ]
          },
          "then": {
            "properties": {
              "return": {
                "properties": {
                  "type": {
                    "const": "CLOSE_TAB"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "open": {
                "properties": {
                  "target": {
                    "const": "MODAL"
                  }
                },
                "required": [
                  "target"
                ]
              }
            },
            "required": [
              "open"
            ]
          },
          "then": {
            "properties": {
              "return": {
                "properties": {
                  "type": {
                    "const": "CLOSE"
                  }
                }
              }
            }
          }
        }
      ],
      "description": "명세 5.2·20.2; 화면 진입·복귀 검증은 실행 단계"
    },
    "parser": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "description": "Java 함수 본문. 외부 격리 없음. 명세 4절"
    },
    "extract": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "TEXT",
            "ATTRIBUTE"
          ]
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "attribute"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "TEXT"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ATTRIBUTE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "description": "5.1·21: TEXT는 텍스트, ATTRIBUTE는 지정 속성; CSS 지원 범위는 실행 환경 검증"
    },
    "fieldConnector": {
      "type": "object",
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "location": {
          "enum": [
            "LIST",
            "DETAIL",
            "ABSENT"
          ]
        },
        "selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extract": {
          "anyOf": [
            {
              "$ref": "#/definitions/extract"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser": {
          "anyOf": [
            {
              "$ref": "#/definitions/parser"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail_navigation": {
          "anyOf": [
            {
              "$ref": "#/definitions/detailNavigation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field_id",
        "location"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "location": {
                "const": "DETAIL"
              }
            },
            "required": [
              "location"
            ]
          },
          "then": {
            "required": [
              "detail_navigation",
              "selector",
              "extract"
            ],
            "properties": {
              "detail_navigation": {
                "$ref": "#/definitions/detailNavigation"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "extract": {
                "$ref": "#/definitions/extract"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "location": {
                "const": "LIST"
              }
            },
            "required": [
              "location"
            ]
          },
          "then": {
            "required": [
              "selector",
              "extract"
            ],
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "extract": {
                "$ref": "#/definitions/extract"
              },
              "detail_navigation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "location": {
                "const": "ABSENT"
              }
            },
            "required": [
              "location"
            ]
          },
          "then": {
            "properties": {
              "selector": {
                "type": "null"
              },
              "detail_navigation": {
                "type": "null"
              },
              "parser": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "명세 5.1; 필드별 대응 여부는 별도 로직"
    },
    "sourceConfig": {
      "type": "object",
      "properties": {
        "project_source_id": {
          "$ref": "#/definitions/uuid"
        },
        "navigation": {
          "$ref": "#/definitions/navigation"
        },
        "connector_revision": {
          "$ref": "#/definitions/positive"
        },
        "field_connectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fieldConnector"
          }
        }
      },
      "required": [
        "project_source_id",
        "navigation",
        "connector_revision",
        "field_connectors"
      ]
    },
    "candidateMapping": {
      "type": "object",
      "properties": {
        "project_source_id": {
          "$ref": "#/definitions/uuid"
        },
        "intermediate_ref": {
          "$ref": "#/definitions/s3Ref"
        },
        "candidate_key": {
          "type": "string"
        },
        "field_id": {
          "$ref": "#/definitions/uuid"
        }
      },
      "required": [
        "project_source_id",
        "intermediate_ref",
        "candidate_key",
        "field_id"
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "schema": {
          "anyOf": [
            {
              "$ref": "#/definitions/schema"
