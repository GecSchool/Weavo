{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "schema.prepared payload",
  "description": "원문 서비스 메시지 명세 18.1",
  "x-weavo-source": "../../../service-message-contracts.md §18.1",
  "type": "object",
  "properties": {
    "project_id": {
      "$ref": "../common.schema.json#/definitions/uuid"
    },
    "change_job_id": {
      "$ref": "../common.schema.json#/definitions/uuid"
    },
    "schema_version": {
      "$ref": "../common.schema.json#/definitions/positive"
    },
    "status": {
      "type": "string",
      "examples": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "project_id",
    "change_job_id",
    "schema_version",
    "status",
    "error"
  ]
}
